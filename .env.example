# Development example only. Copy to .env; never commit real secrets.
DATABASE_URL=postgresql+psycopg://scamgraph:scamgraph@localhost:5432/scamgraph
POSTGRES_USER=scamgraph
POSTGRES_PASSWORD=scamgraph
POSTGRES_DB=scamgraph
MODEL_ARTIFACT_DIR=ml/artifacts/default
MODEL_EMBEDDINGS_ENABLED=true
MODEL_EMBEDDINGS_PATH=ml/artifacts/embedding-model
MAX_FILE_BYTES=8388608
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8080
AUTO_CREATE_SCHEMA=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=4
EXPO_PUBLIC_API_URL=http://localhost:8000/api
# Local demo accounts/data are synthetic. Never enable them in production.
APP_ENV=development
ENABLE_DEMO_SEED=true

# OAuth credentials belong on the backend only. Never use EXPO_PUBLIC_* for secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.your-domain.example/api/auth/oauth/google/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_REDIRECT_URI=https://api.your-domain.example/api/auth/oauth/line/callback
# Exact client handoff destinations; distinct from registered provider callbacks.
OAUTH_REDIRECT_ALLOWLIST=http://localhost:8081/,http://localhost:8080/,scamgraph://oauth
OAUTH_HTTP_TIMEOUT_SECONDS=5

# LINE Official Account Messaging API channel (distinct from LINE Login channel).
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Set true only after confirming both channels are under the same LINE Provider.
LINE_MESSAGING_SAME_PROVIDER=false
LINE_OFFICIAL_ACCOUNT_ID=
# Offline caller feed expires; only non-sample reviewed/confirmed records enter it.
CALLER_DIRECTORY_TTL_HOURS=6
CALLER_DIRECTORY_MAX_AGE_DAYS=90
