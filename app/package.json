{
  "name": "scamgraph-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --clear",
    "web": "expo start --web --clear",
    "build": "expo export --platform web --clear && node ../scripts/export_webapp.cjs",
    "typecheck": "tsc --noEmit",
    "test:flows": "node src/__tests__/social.test.cjs && node src/__tests__/privacy.test.cjs && node src/__tests__/reports.test.cjs && node src/__tests__/visual.test.cjs",
    "test:webapp": "node ../scripts/test_webapp.cjs",
    "ios": "node ../scripts/ios.cjs",
    "android": "expo run:android"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-thai": "^0.4.2",
    "expo": "55.0.31",
    "expo-camera": "~55.0.23",
    "expo-clipboard": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.20",
    "lucide-react-native": "1.52.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
