{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix app",
  "buildCommand": "node scripts/check_web_env.cjs --production && npm run build:web",
  "outputDirectory": "app/dist",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] },
    { "source": "/service-worker.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
      { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
    ] },
    { "source": "/manifest.webmanifest", "headers": [
      { "key": "Cache-Control", "value": "no-cache" },
      { "key": "Content-Type", "value": "application/manifest+json" }
    ] },
    { "source": "/index.html", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|_expo/|assets/|icons/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
